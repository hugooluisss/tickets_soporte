NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=dev_tickets_app
DB_PASSWORD=replace-with-your-local-dev_tickets_app-password
DB_DATABASE=dev_tickets
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=tickets@example.com
